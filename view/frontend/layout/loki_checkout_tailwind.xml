<?xml version="1.0"?>
<!--
Optional XML layout to remove Luma its LESS-based CSS and use Tailwind instead.
To apply, add <update handle="loki_checkout_tailwind"/> to a default.xml layout file of your theme.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <head>
        <remove src="css/styles-m.css"/>
        <remove src="css/styles-l.css"/>
        <remove src="css/print.css"/>
        <css src="Yireo_LokiCheckoutLuma/css/tailwind.css"/>
    </head>
</page>
