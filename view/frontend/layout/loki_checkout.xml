<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <head>
        <!--
        If you don't want to use Tailwind in Luma, use `<remove/>` to your own theme:
        <remove src="Yireo_LokiCheckoutLuma/css/tailwind.css"/>
        -->
        <css src="Yireo_LokiCheckoutLuma/css/tailwind.css"/>
        <css src="Yireo_LokiCheckoutLuma/js/requirejs-additional-config.js"/>
    </head>

    <body>
        <referenceContainer name="content">
            <block name="loki-checkout.required_modules" template="Yireo_LokiCheckoutLuma::required_modules.phtml" before="-"/>
        </referenceContainer>

        <referenceBlock name="minicart" remove="true"/>
    </body>
</page>
