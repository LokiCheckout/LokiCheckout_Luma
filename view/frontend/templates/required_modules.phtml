<?php
declare(strict_types=1);

use Yireo\LokiCheckout\Factory\ViewModelFactory;
use Yireo\LokiCheckoutLuma\ViewModel\RequiredModulesCheck;

/** @var ViewModelFactory $viewModelFactory */
/** @var RequiredModulesCheck $requiredModulesCheck */
$requiredModulesCheck = $viewModelFactory->create(RequiredModulesCheck::class);
$errors = $requiredModulesCheck->getErrors();
if (empty($errors)) {
    return;
}
?>
<div class="messages">
    <?php foreach ($errors as $error): ?>
    <div class="message error">
        <span><?= $error ?></span>
    </div>
    <?php endforeach; ?>
</div>
