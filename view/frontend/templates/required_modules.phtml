<?php
declare(strict_types=1);

/** @version 1.0.7 */

use Magento\Framework\View\Element\Template;
use Loki\CssUtils\Util\CssClass;
use Magento\Framework\Escaper;
use Loki\Components\Factory\ViewModelFactory;
use LokiCheckout\Luma\ViewModel\RequiredModulesCheck;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelFactory $viewModelFactory */
/** @var RequiredModulesCheck $requiredModulesCheck */
/** @var CssClass $css */

$requiredModulesCheck = $viewModelFactory->create(RequiredModulesCheck::class);
$errors = $requiredModulesCheck->getErrors();
if (empty($errors)) {
    return;
}
?>
<div class="<?= /* @noEscape */ $css('messages') ?>">
    <?php foreach ($errors as $error): ?>
    <div class="<?= /* @noEscape */ $css('message error', 'message') ?>">
        <span><?= $escaper->escapeHtml($error) ?></span>
    </div>
    <?php endforeach; ?>
</div>
