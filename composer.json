{
    "name": "loki-checkout/magento2-luma",
    "version": "1.0.26",
    "description": "Luma compatibility for Loki Checkout",
    "keywords": [
        "loki-checkout",
        "loki-checkout-plan-trial",
        "loki-checkout-category-theme"
    ],
    "homepage": "https://loki-checkout.com/",
    "authors": [
        {
            "name": "Jisse Reitsma (Yireo)",
            "email": "jisse@yireo.com"
        }
    ],
    "type": "magento2-module",
    "require": {
        "loki-checkout/magento2-core": "^2.0",
        "loki/magento2-components": "^2.0",
        "loki/magento2-css-utils": "^1.0",
        "magento/framework": "^103.0",
        "magento/module-store": "^101.0"
    },
    "suggest": {
        "loki-theme/magento2-luma-components": "Replace Luma legacy JavaScript with modern JS components",
        "loki-checkout/magento2-luma-skinny": "Skin down your Luma theme to optimize the checkout",
        "yireo/magento2-theme-by-route": "Apply a specific theme to a specific route only"
    },
    "license": "OSL-3.0",
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "LokiCheckout\\Luma\\": ""
        }
    }
}