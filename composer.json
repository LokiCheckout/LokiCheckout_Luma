{
  "name": "loki-checkout/magento2-luma",
  "version": "0.0.15",
  "description": "Luma compatibility for Loki Checkout",
  "keywords": [
    "loki-theme"
  ],
  "homepage": "https://loki-checkout.com/",
  "authors": [
    {
      "name": "Jisse Reitsma (Yireo)",
      "email": "jisse@yireo.com"
    }
  ],
  "type": "magento2-module",
  "require": {
    "loki-checkout/magento2-core": "~0.0 | ^1.0",
    "loki/magento2-components": "~0.0 | ^1.0",
    "yireo/magento2-hyva-theme-auto-registration": "^1.0",
    "magento/framework": "^103.0",
    "magento/module-store": "^101.0"
  },
  "suggest": {
    "loki-checkout/magento2-luma-skinny": "Skin down your Luma theme to optimize the checkout"
  },
  "license": "OSL-3.0",
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "LokiCheckout\\Luma\\": ""
    }
  }
}
